digraph CFG {
  rankdir=TB;
  node [shape=box,fontname="Arial"];
  e [label="e: entry / atomic"];
  cas [label="cas: conditional revision UPDATE"];
  u [label="u: updated != 0?"];
  stale [label="stale: raise ScenarioError: stale"];
  load [label="load: load attempt + current"];
  v [label="v: selected in range(4)?"];
  invalid [label="invalid: raise ScenarioError: option"];
  ans [label="ans: create Answer"];
  last [label="last: step >= length?"];
  complete [label="complete: set COMPLETED, finished, current=None"];
  choose [label="choose: next_target + _choose"];
  save [label="save: save attempt"];
  ret [label="ret: return attempt / commit"];
  handler [label="handler: translate Integrity/Operational -> ScenarioError"];
  x [label="x: exit (rollback on exception)"];
  e -> cas [label=""];
  cas -> u [label="ok"];
  cas -> handler [label="I/O"];
  u -> stale [label="F"];
  stale -> x [label=""];
  u -> load [label="T"];
  load -> v [label="ok"];
  load -> handler [label="I/O"];
  v -> invalid [label="F"];
  invalid -> x [label=""];
  v -> ans [label="T"];
  ans -> last [label="ok"];
  ans -> handler [label="I/O"];
  last -> complete [label="T"];
  complete -> save [label=""];
  last -> choose [label="F"];
  choose -> save [label="ok"];
  choose -> handler [label="I/O"];
  save -> ret [label="ok"];
  save -> handler [label="I/O"];
  ret -> x [label=""];
  handler -> x [label=""];
}
